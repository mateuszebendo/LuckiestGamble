<?xml version="1.0" encoding="UTF-8" ?>
<taglib xmlns="http://java.sun.com/xml/ns/javaee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-jsptaglibrary_2_1.xsd"
        version="2.1">

    <display-name>String Functions</display-name>
    <tlib-version>1.0</tlib-version>
    <short-name>strfn</short-name>
    <uri>/WEB-INF/tlds/stringFunctions</uri>
    <function>
        <name>toNormalCase</name>
        <function-class>org.cefet.utils.StringConverter</function-class>
        <function-signature>java.lang.String snakeToNormalCase(java.lang.String)</function-signature>
    </function>
</taglib>