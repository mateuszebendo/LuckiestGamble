<div id="form-cadastro" class="modal-content rounded-4 shadow" style="display: none">
    <div class="modal-header p-5 pb-4 border-bottom-0">
        <h1 class="fw-bold mb-0 fs-2">Cadastro</h1>
    </div>
    <div class="modal-body p-5 pt-0">
        <form action="${pageContext.request.contextPath}/app/usuario/cadastro" class="" method="post">
            <div class="form-floating mb-3">
                <input name="nome" type="text" class="form-control rounded-3" id="floatingInputUser" placeholder="Nome de Usuário" required>
                <label for="floatingInputUser">
                    User
                </label>
                <div class="invalid-feedback" id="erroNome">
                </div>
            </div>
            <div class="form-floating mb-3">
                <input name="email" type="email" class="form-control rounded-3" id="floatingInputEmail" placeholder="name@example.com" required>
                <label for="floatingInputEmail">
                    Email
                </label>
                <div class="invalid-feedback" id="erroEmail">
                </div>
            </div>
            <div class="form-floating mb-3">
                <input name="dataNascimento" type="date" class="form-control rounded-3" id="floatingInputDate" required>
                <label for="floatingInputDate">
                    Data de Nascimento
                </label>
                <div class="invalid-feedback" id="erroDataNascimento">
                </div>
            </div>
            <div class="form-floating mb-3">
                <input name="senhaPrincipal" type="password" class="form-control rounded-3" id="floatingPassword" placeholder="Senha" required>
                <label for="floatingPassword">
                    Senha
                </label>
                <div class="invalid-feedback" id="erroSenha">
                </div>
            </div>
            <button id="btn-criar-conta" class="w-100 mb-2 btn btn-lg rounded-3 btn-primary" type="submit">
                Criar conta
            </button>
            <hr class="my-4">
            <h1 class="fw-bold mb-3 fs-2">Ou caso possua uma conta</h1>
            <button id="btn-login" class="w-100 py-2 mb-2 btn btn-outline-secondary rounded-3" type="submit">
                Logar
            </button>
        </form>
    </div>
</div>