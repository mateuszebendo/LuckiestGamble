<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib uri="jakarta.tags.core" prefix="c" %>

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title><c:out value="${tituloPagina}" default="Meu Site JSP" /></title>

    <c:set var="contextPath" value="${pageContext.request.contextPath}" />

    <%-- Estilos CSS Comuns --%>
    <link rel="stylesheet" href="${contextPath}/css/style.css" type="text/css"/>
    <link rel="stylesheet" href="${contextPath}/css/sideBar.css" type="text/css"/>
    <link rel="stylesheet" href="${contextPath}/webjars/bootstrap/5.3.2/css/bootstrap.min.css"/>
</head>
